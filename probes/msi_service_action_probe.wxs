<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="SWCompat Original MSI Service Action Probe"
           Manufacturer="SWCompat Open Compatibility Research"
           Version="1.0.0"
           UpgradeCode="{21CD34C0-DBA1-41F7-91DA-88C2105F3E90}"
           Scope="perMachine">
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="SWCompatServiceActionDir" Name="SWCompatMsiServiceAction">
        <Component Id="ServiceExeComponent" Guid="{C26ADE5D-9309-42DE-A997-FDA02406DF15}">
          <File Id="ServiceExeFile" Source="build/service_smoke.exe" KeyPath="yes" />
          <ServiceInstall Id="OriginalServiceInstall"
                          Name="SWCompatOriginalServiceTest"
                          DisplayName="SWCompat Original Harmless Service"
                          Description="Isolated self-authored MSI/SCM regression fixture"
                          Type="ownProcess" Start="demand" ErrorControl="normal"
                          Arguments="run" Vital="yes" />
          <ServiceControl Id="OriginalServiceControl"
                          Name="SWCompatOriginalServiceTest"
                          Start="install" Stop="uninstall" Remove="uninstall"
                          Wait="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="ServiceProbeFeature" Title="MSI Service Lifecycle" Level="1">
      <ComponentRef Id="ServiceExeComponent" />
    </Feature>
  </Package>
</Wix>
